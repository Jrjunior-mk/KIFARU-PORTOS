# Copy to infra/docker/.env.compose (git-ignored) and run:
#   docker compose --env-file infra/docker/.env.compose -f infra/docker/docker-compose.yml up --build
# Values here are LOCAL DEVELOPMENT defaults. Never reuse them anywhere reachable from the internet.

# --- infrastructure containers ---
POSTGRES_USER=kifaru
POSTGRES_PASSWORD=kifaru_dev
POSTGRES_DB=kifaru
POSTGRES_PORT=5432
REDIS_PORT=6379
MQTT_PORT=1883
MQTTS_PORT=8883
MQTT_WS_PORT=8083
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_PASSWORD=kifaru_dev

# --- application ports ---
API_PORT=8000
WEB_PORT=5173

# --- API settings (prefix KIFARU_; see apps/api/.env.example for the full list) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
KIFARU_JWT_SECRET=CHANGE-ME-local-compose-secret-32-chars-minimum
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
KIFARU_SIGNING_SEED_B64=
KIFARU_SIGNING_KEY_ID=platform-dev-key
KIFARU_LOG_LEVEL=INFO
KIFARU_AUDIT_SAMPLE_RATE=0.02
KIFARU_RATE_LIMIT_PER_MINUTE=300
# Seed demo organisations/users/stations on start-up (see apps/api/kifaru/seed.py). Set false to keep an empty DB.
KIFARU_SEED_DEMO=true
