# KIFARU PORTOS - dev environment. Copy to terraform.tfvars (git-ignored) and replace every <PLACEHOLDER>.
# Budget target: about USD 60-90/month (single NAT, no interface endpoints, t4g.micro, single-node Redis, Spot tasks).

env        = "dev"
aws_region = "af-south-1"
dr_region  = "eu-west-1"

# --- Owner-provided ------------------------------------------------------------------------------------------------------
route53_zone_id   = "<ROUTE53_ZONE_ID>"
web_domain        = "app.dev.<DOMAIN>"
api_domain        = "api.dev.<DOMAIN>"
api_origin_domain = "api-origin.dev.<DOMAIN>"
alarm_email       = "<ops-alerts@example.com>"

github_org              = "<GITHUB_ORG>"
github_repo             = "kifaru-portos"
github_allowed_subjects = ["environment:dev", "ref:refs/heads/main"]
create_oidc_provider    = true # dev is the first root applied in a shared account; set false if staging/prod share this account and already created it

state_bucket_arn     = "arn:aws:s3:::kifaru-terraform-state-<ACCOUNT_ID>"
state_lock_table_arn = "arn:aws:dynamodb:af-south-1:<ACCOUNT_ID>:table/kifaru-terraform-locks"

# --- Images --------------------------------------------------------------------------------------------------------------
image_tag        = "latest" # overridden by the deploy workflow (-var image_tag=<git sha>)
cpu_architecture = "X86_64"

# --- Network -------------------------------------------------------------------------------------------------------------
vpc_cidr                   = "10.40.0.0/16"
single_nat_gateway         = true
enable_interface_endpoints = false # saves ~USD 35/month; traffic to AWS APIs goes through the NAT gateway

# --- Compute -------------------------------------------------------------------------------------------------------------
use_fargate_spot           = true
restrict_alb_to_cloudfront = true
create_seed_task           = true # demo users (see apps/api/kifaru/seed.py) are allowed in dev
log_level                  = "DEBUG"
log_retention_days         = 14
# services = {} # defaults in variables.tf are already dev-sized (1 task each)

# --- Database ------------------------------------------------------------------------------------------------------------
rds_instance_class                  = "db.t4g.micro"
rds_allocated_storage               = 20
rds_max_allocated_storage           = 100
rds_multi_az                        = false
rds_deletion_protection             = false
rds_skip_final_snapshot             = true
rds_cross_region_backup_replication = false
rds_max_connections_alarm           = 60

# --- Redis ---------------------------------------------------------------------------------------------------------------
redis_node_type                = "cache.t4g.micro"
redis_num_cache_clusters       = 1
redis_snapshot_retention_limit = 1

# --- Storage -------------------------------------------------------------------------------------------------------------
s3_enable_replication = false
s3_force_destroy      = true

# --- IoT -----------------------------------------------------------------------------------------------------------------
iot_mode           = "iot_core" # or "none" when only the built-in simulator is used in dev
enable_iot_logging = true

# --- Edge ----------------------------------------------------------------------------------------------------------------
cloudfront_price_class = "PriceClass_100" # dev does not need African PoPs
waf_rate_limit         = 2000
waf_rate_limit_auth    = 100

# --- Secrets / backups ---------------------------------------------------------------------------------------------------
secrets_recovery_window_in_days = 0
enable_pg_dump                  = false
