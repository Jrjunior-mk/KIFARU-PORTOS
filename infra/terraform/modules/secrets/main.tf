# ---------------------------------------------------------------------------------------------------------------------
# secrets: customer-managed KMS key plus the application secrets the API reads at start-up.
#
#   <prefix>/jwt-secret        KIFARU_JWT_SECRET         random 64-char string generated by Terraform (state is sensitive)
#   <prefix>/signing-seed      KIFARU_SIGNING_SEED_B64   32 random bytes, base64 (Ed25519 seed for ticket/ledger signing)
#   <prefix>/app-secrets       JSON of third-party credentials; values are placeholders to be set out-of-band
#
# Terraform state therefore contains these values: the state bucket is KMS-encrypted and access-restricted (see bootstrap/).
# Rotation of the JWT secret = `terraform taint`/`-replace` of random_password.jwt followed by a rolling deploy.
# ---------------------------------------------------------------------------------------------------------------------

locals {
  tags = merge(var.tags, { DataClass = "Secret" })
}

data "aws_caller_identity" "current" {}

resource "aws_kms_key" "secrets" {
  description             = "${var.name_prefix} application secrets"
  deletion_window_in_days = 30
  enable_key_rotation     = true
  tags                    = local.tags
}

resource "aws_kms_alias" "secrets" {
  name          = "alias/${var.name_prefix}-secrets"
  target_key_id = aws_kms_key.secrets.key_id
}

# --- JWT secret --------------------------------------------------------------------------------------------------------

resource "random_password" "jwt" {
  length  = 64
  special = false
}

resource "aws_secretsmanager_secret" "jwt" {
  name                    = "${var.secret_path_prefix}/jwt-secret"
  description             = "HS256 signing secret for KIFARU access/refresh tokens"
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = var.recovery_window_in_days
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "jwt" {
  secret_id     = aws_secretsmanager_secret.jwt.id
  secret_string = random_password.jwt.result
}

# --- Ed25519 signing seed ---------------------------------------------------------------------------------------------

resource "random_bytes" "signing_seed" {
  length = 32
}

resource "aws_secretsmanager_secret" "signing_seed" {
  name                    = "${var.secret_path_prefix}/signing-seed"
  description             = "Base64 Ed25519 seed used to sign weighing tickets and ledger entries (key id ${var.signing_key_id})"
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = var.recovery_window_in_days
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "signing_seed" {
  secret_id     = aws_secretsmanager_secret.signing_seed.id
  secret_string = random_bytes.signing_seed.base64
}

# --- Third-party credentials (placeholders) ---------------------------------------------------------------------------

resource "aws_secretsmanager_secret" "app" {
  name                    = "${var.secret_path_prefix}/app-secrets"
  description             = "Third-party adapter credentials (Africa's Talking, KeNHA/KRA/NTSA tokens, Sentry). Values are set by the owner, not Terraform."
  kms_key_id              = aws_kms_key.secrets.arn
  recovery_window_in_days = var.recovery_window_in_days
  tags                    = local.tags
}

resource "aws_secretsmanager_secret_version" "app" {
  secret_id     = aws_secretsmanager_secret.app.id
  secret_string = jsonencode({ for k in var.external_adapter_keys : k => "" })

  lifecycle {
    # Once the owner has set real values in the console/CLI, Terraform must not overwrite them with placeholders.
    ignore_changes = [secret_string]
  }
}
